import torch
from ppo_baseline import PPOAgent, create_env
import os
import numpy as np

# Flatland imports
from flatland.envs.rail_env import RailEnv
from flatland.envs.rail_generators import sparse_rail_generator
from flatland.envs.line_generators import sparse_line_generator
from flatland.envs.observations import GlobalObsForRailEnv



GRID_WIDTH = 25
GRID_HEIGHT = 25
N_AGENTS = 2
N_CITIES = 4
MAX_RAILS_BETWEEEN_CITIES = 2
MAX_RAILS_PAIRS_IN_CITY = 2  # Teniamo basso il numero perché ogni agente ha la sua rete neurale
SEED = 42


OUT_DIR = "./ppo_eval"
os.makedirs(OUT_DIR, exist_ok=True)


def create_env():
    obs_builder = GlobalObsForRailEnv()
    env = RailEnv(
        width=GRID_WIDTH,
        height=GRID_HEIGHT,
        rail_generator=sparse_rail_generator(max_rails_between_cities=MAX_RAILS_BETWEEEN_CITIES, max_rail_pairs_in_city=MAX_RAILS_PAIRS_IN_CITY, 
                                             max_num_cities=N_CITIES, seed=SEED, grid_mode=True),
        line_generator=sparse_line_generator(seed=SEED),
        number_of_agents=N_AGENTS,
        obs_builder_object=obs_builder,
        random_seed=SEED
    )
    return env

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')


if __name__ == "__main__":

    env = create_env()
    dummy_obs, _ = env.reset()
    obs_shape = [dummy_obs[0][0].size, dummy_obs[0][1].size, dummy_obs[0][2].size]
    state_dim = np.sum(obs_shape)
    action_dim = 5

    agents = {}


    # Load agents
    for handle in range(env.get_num_agents()):
        print(f"Loading weights for Agente PPO indipendente per il Treno {handle}")
        agents[handle] = PPOAgent(state_dim, action_dim, agent_id=handle)
        PATH = os.path.join("./ppo_independent_results", f'ppo_independent_agent_{handle}_final.pkl')
        agents[handle].load_state_dict(torch.load(PATH, weights_only=True))
        agents[handle].eval()


    
    obs_dict, info_dict = env.reset(regenerate_rail=False, regenerate_schedule=False, random_seed=SEED)
    total_rewards = {h: 0 for h in range(N_AGENTS)}
    done_dict = {a: False for a in range(N_AGENTS)}
    delay_dict = {h: 0 for h in range(N_AGENTS)}

    elapsed_steps = 0

    while True:
        actions_dict = {}
        
        for handle in range(env.get_num_agents()):
            if not done_dict.get(handle, False):
                state = np.concatenate([o.flatten() for o in obs_dict[handle]])
                state_tensor = torch.FloatTensor(state).to(device)
                with torch.no_grad():
                    action_probs, _, = agents[handle].policy(state_tensor)
                action = torch.argmax(action_probs).item()
                actions_dict[handle] = action

        obs_dict, rewards_dict, done_dict, info_dict = env.step(actions_dict)

        if done_dict['__all__']:
            break

        for handle, reward in rewards_dict.items():
            total_rewards[handle] += reward
        
        elapsed_steps += 1

    arrived_trains = [train.handle for train in env.agents \
                    if train.position == None and train.arrival_time != None]
    
    delays = [train.get_current_delay(elapsed_steps, env.distance_map) for train in env.agents]

    print("Valutazione Independent PPO completata.")
    print(f"Total Rewards: {total_rewards}")
    print(f"Elapsed Steps: {elapsed_steps}")    
    print("Reward per Agent:")
    for handle, reward in total_rewards.items():
        print(f"Agent {handle}: {reward}")
    print(f"Arrived Trains: {arrived_trains}")
    print(f"Delays: {delays}")


    np.savez_compressed(os.path.join(OUT_DIR, 'arrived_trains.npz'), x=arrived_trains)
    np.savez_compressed(os.path.join(OUT_DIR, 'delays.npz'), x=delays)